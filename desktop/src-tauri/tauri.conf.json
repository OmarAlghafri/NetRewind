{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetRewind",
  "version": "1.2.0",
  "identifier": "com.github.omaralghafri.netrewind",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NetRewind",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage"],
    "publisher": "NetRewind",
    "category": "Utility",
    "shortDescription": "The network black box recorder's viewer",
    "longDescription": "Shows what changed on the network and why, from a live NetRewind recorder on this machine or from an evidence bundle received from elsewhere. Reads only; never touches the record.",
    "license": "AGPL-3.0-only",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/desktop-resources/recorder/": "recorder/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": true,
        "languages": ["English", "Arabic"]
      },
      "wix": {
        "language": ["en-US"]
      }
    },
    "linux": {
      "deb": {
        "depends": [],
        "recommends": ["netrewind"],
        "section": "net"
      },
      "rpm": {
        "depends": [],
        "epoch": 0,
        "release": "1"
      }
    }
  }
}
