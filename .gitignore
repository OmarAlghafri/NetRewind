# Go build output
build/
dist/
# Release artefacts, built by `make release DIST=release`. They are large,
# they are reproducible from the tag, and a checksum file in git is one that
# disagrees with the one published.
release/
*.exe
*.test
*.out

# Compiled eBPF objects are committed: they are built by clang on Linux, and
# committing them keeps the tree building on a machine without a BPF toolchain.

# Runtime data - the event store is machine-local, never versioned
*.db
*.db-wal
*.db-shm
var/

# Secrets / real inventory - never commit real credentials or real networks
devices.yaml
*.secret
.env

# Python (lab tooling)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/

# Runtime / temp
*.tmp
*.log
# ...except docs/evidence/*.log: these are permanent, durable QA/test
# transcripts (real commands + real output), not runtime/temp files - the
# ".log" extension is just their naming convention. Without this exemption
# the blanket rule above silently drops every one of them from `git add`.
!docs/evidence/*.log

# Transient run outputs
snapshots/
reports/*.md

# GNS3 project working directory (topology is built through the API; its runtime
# artifacts are machine-specific and not versioned inside the code repo).
NetRewind*Lab/

# Downloaded model weights for ai/eval benchmarking - multi-GB binaries,
# never versioned; docs/evidence/*.log records what was downloaded, from
# where, and what it scored, which is the part that actually needs to survive.
ai/eval/models/
# Raw per-run benchmark output (ai/eval/run) - regenerable by re-running
# against the same model; docs/evidence/*.log carries the summarized,
# permanent record of each real run instead.
ai/eval/results/

# Working notes kept during development to track phase status and open
# questions - useful locally, not project documentation.
docs/agent-state/
